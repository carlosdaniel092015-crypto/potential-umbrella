# Copiar a .env y completar. NUNCA commitear .env (docs §5.4: los secretos van en
# Vault/Secrets Manager en staging/producción; .env solo para desarrollo local).

# --- Django ---
DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=apps.admin_panel.settings.dev

# Marca el entorno. Con production/staging, arrancar con settings .dev aborta.
ENVIRONMENT=dev
# Token para /internal/* (obligatorio fuera de dev)
INTERNAL_API_TOKEN=

# --- Base de datos (PostgreSQL; en dev sin Docker cae a SQLite si DB_ENGINE=sqlite) ---
DB_ENGINE=postgres
DB_NAME=whatsapp_ai
DB_USER=whatsapp_ai
DB_PASSWORD=cambiar
DB_HOST=localhost
DB_PORT=5432

# --- Redis (memoria conversacional + broker Celery, ADR-03) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- YCloud (WhatsApp) ---
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_BASE_URL=https://api.ycloud.com/v2
# En dev sin secreto configurado se puede desactivar la verificación de firma:
WEBHOOK_SIGNATURE_REQUIRED=true

# --- LLM (patrón Adapter: openai | fake) ---
LLM_PROVIDER=fake
LLM_MODEL=gpt-4.1
OPENAI_API_KEY=

# --- Fases futuras ---
# ELEVENLABS_API_KEY=            (Fase 4)
# ODOO_URL= ODOO_DB= ODOO_USER= ODOO_PASSWORD=   (Fase 3)
